{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"b8fcbc20-2cbc-4c6b-9837-63844479c20e\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"b8fcbc20-2cbc-4c6b-9837-63844479c20e\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with elementary_test_results as (\n            select * from `workspace`.`marketing_dev_elementary`.`elementary_test_results`\n        ),\n\n        test_invocation as (\n            select  distinct invocation_id, detected_at\n            from elementary_test_results\n            \n            order by detected_at desc\n            limit 1\n        )\n\n        \n            \n            \n            select\n                test_invocation.invocation_id,\n                test_invocation.detected_at,\n                invocations.command,\n                invocations.selected,\n                invocations.full_refresh,\n                invocations.job_run_id,\n                invocations.job_run_url\n            from test_invocation left join `workspace`.`marketing_dev_elementary`.`dbt_invocations` as invocations\n            on test_invocation.invocation_id = invocations.invocation_id\n        \n    \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "b8fcbc20-2cbc-4c6b-9837-63844479c20e", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"b8fcbc20-2cbc-4c6b-9837-63844479c20e\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"b8fcbc20-2cbc-4c6b-9837-63844479c20e\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with elementary_test_results as (\n            select * from `workspace`.`marketing_dev_elementary`.`elementary_test_results`\n        ),\n\n        test_invocation as (\n            select  distinct invocation_id, detected_at\n            from elementary_test_results\n            \n            order by detected_at desc\n            limit 1\n        )\n\n        \n            \n            \n            select\n                test_invocation.invocation_id,\n                test_invocation.detected_at,\n                invocations.command,\n                invocations.selected,\n                invocations.full_refresh,\n                invocations.job_run_id,\n                invocations.job_run_url\n            from test_invocation left join `workspace`.`marketing_dev_elementary`.`dbt_invocations` as invocations\n            on test_invocation.invocation_id = invocations.invocation_id\n        \n    \n\n  ", "name": "SQLQuery", "pid": 4686, "thread": "MainThread", "ts": "2026-10-20T09:34:42.422664Z"}}
