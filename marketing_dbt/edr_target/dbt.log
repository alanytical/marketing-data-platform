{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"2ddea731-5ffd-4bc4-a6a4-c6f4becb7921\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \nSELECT\n  table_name,\n  if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n  lower(data_source_format) AS file_format,\n  table_owner,\n  if(\n    table_type IN (\n      'EXTERNAL',\n      'MANAGED',\n      'MANAGED_SHALLOW_CLONE',\n      'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n  ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'workspace'\n  AND table_schema = 'marketing_dev_elementary'\n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2ddea731-5ffd-4bc4-a6a4-c6f4becb7921", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"2ddea731-5ffd-4bc4-a6a4-c6f4becb7921\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \nSELECT\n  table_name,\n  if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n  lower(data_source_format) AS file_format,\n  table_owner,\n  if(\n    table_type IN (\n      'EXTERNAL',\n      'MANAGED',\n      'MANAGED_SHALLOW_CLONE',\n      'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n  ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'workspace'\n  AND table_schema = 'marketing_dev_elementary'\n\n  ", "name": "S